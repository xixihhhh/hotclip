{
  "name": "hotclip",
  "version": "0.26.0",
  "description": "Turn long videos & livestream replays into viral vertical shorts — AI highlight detection, auto captions, 9:16 reframe. Free, local-first, no watermark. 长视频/直播回放一键切成爆款竖屏短视频。",
  "main": "./out/main/index.js",
  "author": "xixihhhh",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/xixihhhh/hotclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/xixihhhh/hotclip.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "quality:eval": "tsx tools/quality-eval.ts",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "start": "electron-vite preview",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unbzip2-stream": "^1.4.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sherpa-onnx-node": "^1.13.3",
    "tailwindcss": "^4.3.2",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/win32-x64",
      "@ffprobe-installer/linux-x64",
      "electron-winstaller"
    ]
  }
}
